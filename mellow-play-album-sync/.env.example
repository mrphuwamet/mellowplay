# Copy this file to .env and fill in your own values.
# Never commit the real .env — it holds your CRM admin password.

# The backend API, same one the CRM talks to.
API_URL=https://api.mellowplay.co

# A real CRM admin account. The tool logs in with this on startup and every
# few hours after, and refuses to watch anything if the login fails — no
# login, no upload, same rule the CRM itself follows.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The folder this tool watches. Make one subfolder per album, named exactly
# like the album's name in the CRM, each holding a New/ folder to drop
# photos into:
#
#   <ALBUM_SYNC_ROOT>/
#     งานกีฬาสี 2569/
#       New/        <- drop photos here
#       Uploaded/   <- the tool moves them here once they're in the album
#       Failed/     <- and here if a photo could not be uploaded, with a
#                      .error.txt beside it saying why
#
# An album must already exist in the CRM — this tool only adds photos to
# one that's there, it never creates one.
ALBUM_SYNC_ROOT=./photos

# Leave as false unless New/ lives on a network drive or a mount where
# ordinary file-change notifications don't arrive (some NAS shares, some VPN
# drives) — then the tool has to poll instead of waiting for events, which
# costs a little CPU but still works.
WATCH_USE_POLLING=false
